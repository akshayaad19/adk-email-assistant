# --- Gemini (model that powers the agent) ---
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash

# --- Microsoft Graph: Option A, OAuth (preferred) ---
# Application (client) ID of your Azure / Entra app registration.
# No app registration (e.g. personal account without a directory)? Use Microsoft's public
# "Microsoft Graph Command Line Tools" client: 14d82eec-204b-4c2f-b7e8-296a70dab67e
MS_CLIENT_ID=14d82eec-204b-4c2f-b7e8-296a70dab67e
# "consumers" for personal Outlook.com accounts, "common" for any, or your tenant ID
MS_TENANT=consumers

# Optional: send as this alias of your mailbox (needed if your Microsoft account's
# primary address is e.g. a Gmail address; otherwise Gmail rejects the sent mail).
MAIL_FROM=

# --- Microsoft Graph: Option B, bearer token fallback ---
# Paste an access token (e.g. from Graph Explorer). Used only when MS_CLIENT_ID is empty.
GRAPH_ACCESS_TOKEN=
